{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumixHDR",
  "version": "0.1.0",
  "identifier": "app.lumixhdr.desktop",
  "build": {
    "beforeDevCommand": "yarn workspace ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn workspace ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LumixHDR",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
