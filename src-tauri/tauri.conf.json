{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumixHDR",
  "version": "0.1.0",
  "identifier": "app.lumixhdr.desktop",
  "build": {
    "beforeDevCommand": "yarn workspace ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn workspace ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LumixHDR",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost https://github.com https://*.github.com https://objects.githubusercontent.com",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2NkNFNUI0RDI1NTQyQUQKUldTdFFsWFN0T1ZzaGtoUUp2MDE2SUc4YzREMERzdW5FelorS01Ma0V1TFE3R0I2K1N5YVJSWFMK",
      "endpoints": [
        "https://github.com/MisterGoodDeal/lumix-hdr/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
